    {
      "parameters": {
        "jsCode": "// 1. Получаем ID напрямую из Webhook (обходим предыдущий узел)\nconst requestBody = $('Webhook').first().json.body;\nconst noteId = requestBody.id;\n\n// Проверка, что ID передан\nif (!noteId) throw new Error(\"Не передан ID заметки для удаления\");\n\n// 2. Пытаемся прочитать файл (если пустой или его нет - создаем пустой массив)\nlet notesArray = [];\ntry {\n    const binaryData = $input.first().binary.data;\n    if (binaryData) {\n        const fileContent = Buffer.from(binaryData.data, 'base64').toString('utf8');\n        notesArray = JSON.parse(fileContent);\n    }\n} catch (e) {\n    notesArray = [];\n}\n\n// 3. Удаляем заметку (оставляем все, кроме совпадающей по ID)\nconst updatedNotes = notesArray.filter(note => note.id != noteId);\n\n// 4. Формируем файл для записи\nconst content = JSON.stringify(updatedNotes, null, 2);\n\nreturn [{\n    json: {},\n    binary: {\n        data: {\n            data: Buffer.from(content).toString('base64'),\n            mimeType: 'application/json',\n            fileName: 'notes.json'\n        }\n    }\n}];"
      },
