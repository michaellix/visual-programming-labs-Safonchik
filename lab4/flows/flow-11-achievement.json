    {
      "parameters": {
        "jsCode": "// Получаем бинарный буфер файла (0 — индекс первого элемента, 'data' — имя поля)\nconst binaryDataBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// Преобразуем буфер в строку и парсим JSON\nconst fileContent = JSON.parse(binaryDataBuffer.toString('utf8'));\n\n// Возвращаем данные в формате, который ожидает n8n\nreturn [{ json: { notes: fileContent } }];"
      },
