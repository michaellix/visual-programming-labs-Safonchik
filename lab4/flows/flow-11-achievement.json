        "jsCode": "const noteText = $input.first().json.body.text || \"Пустая заметка\";\nconst content = JSON.stringify({ \n    id: Date.now().toString(),\n    text: noteText, \n    date: new Date().toISOString() \n}, null, 2);\n\nreturn [{\n    json: {},\n    binary: { data: { data: Buffer.from(content).toString('base64'), mimeType: 'application/json', fileName: 'notes.json' } }\n}];"
