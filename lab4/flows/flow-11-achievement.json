      "name": "Read/Write Files from Disk2"
    },
    {
      "parameters": {
        "jsCode": "// 1. Получаем данные из Webhook напрямую (обходя предыдущий узел)\nconst requestBody = $('Webhook').first().json.body;\nconst noteId = requestBody.id;\nconst newText = requestBody.text;\n\n// Проверка, что ID передан\nif (!noteId) throw new Error(\"Не передан ID заметки для обновления\");\n\n// 2. Пытаемся прочитать файл (если он пуст или его нет - создаем пустой массив)\nlet notesArray = [];\ntry {\n    const binaryData = $input.first().binary.data;\n    if (binaryData) {\n        const fileContent = Buffer.from(binaryData.data, 'base64').toString('utf8');\n        notesArray = JSON.parse(fileContent);\n    }\n} catch (e) {\n    // Если файл битый или пустой, начинаем с пустого массива\n    notesArray = [];\n}\n\n// 3. Обновляем заметку\nconst updatedNotes = notesArray.map(note => {\n    if (note.id == noteId) {\n        return { ...note, text: newText, updatedAt: new Date().toISOString() };\n    }\n    return note;\n});\n\n// 4. Формируем файл для записи\nconst content = JSON.stringify(updatedNotes, null, 2);\n\nreturn [{\n    json: {},\n    binary: {\n        data: {\n            data: Buffer.from(content).toString('base64'),\n            mimeType: 'application/json',\n            fileName: 'notes.json'\n        }\n    }\n}];"
      },
